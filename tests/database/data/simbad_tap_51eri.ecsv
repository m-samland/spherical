# %ECSV 1.0
# ---
# datatype:
# - name: user_specified_id
#   datatype: string
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: user_specified_ra, datatype: float64}
# - {name: user_specified_dec, datatype: float64}
# - {name: user_specified_mjd_obs, datatype: float64}
# - name: main_id
#   datatype: string
#   description: Main identifier for an object
#   meta: !!omap
#   - {ucd: meta.id;meta.main}
#   - {utype: 'mango:MangoObject.identifier'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: all_ids
#   datatype: string
#   description: List of all identifiers concatenated with pipe
#   meta: !!omap
#   - {ucd: meta.id}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: ra
#   unit: deg
#   datatype: float64
#   description: Right ascension
#   meta: !!omap
#   - {ucd: pos.eq.ra;meta.main}
#   - {utype: 'mango:EpochPosition.longitude[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: Declination
#   meta: !!omap
#   - {ucd: pos.eq.dec;meta.main}
#   - {utype: 'mango:EpochPosition.latitude[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: otype
#   datatype: string
#   description: Object type
#   meta: !!omap
#   - {ucd: src.class}
#   - {utype: 'mango:Label.text[CT.vocabulary=https://www.ivoa.net/rdf/uat#classification]'}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: sp_type
#   datatype: string
#   description: MK spectral type
#   meta: !!omap
#   - {ucd: src.spType}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: flux_v
#   datatype: float64
#   description: V magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.V}
#   - {utype: 'mango:Brightness.value[CS.photCal=V]'}
# - name: flux_r
#   datatype: float64
#   description: R magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.R}
#   - {utype: 'mango:Brightness.value[CS.photCal=R]'}
# - name: flux_i
#   datatype: float64
#   description: I magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.opt.I}
#   - {utype: 'mango:Brightness.value[CS.photCal=I]'}
# - name: flux_j
#   datatype: float64
#   description: J magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.J}
#   - {utype: 'mango:Brightness.value[CS.photCal=J]'}
# - name: flux_h
#   datatype: float64
#   description: H magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.H}
#   - {utype: 'mango:Brightness.value[CS.photCal=H]'}
# - name: flux_k
#   datatype: float64
#   description: K magnitude
#   meta: !!omap
#   - {ucd: phot.mag;em.IR.K}
#   - {utype: 'mango:Brightness.value[CS.photCal=K]'}
# - name: pmra
#   unit: mas / yr
#   datatype: float64
#   description: Proper motion in RA
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.ra}
#   - {utype: 'mango:EpochPosition.pmLongitude[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: pmdec
#   unit: mas / yr
#   datatype: float64
#   description: Proper motion in DEC
#   meta: !!omap
#   - {ucd: pos.pm;pos.eq.dec}
#   - {utype: 'mango:EpochPosition.pmLatitude[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: pm_err_maja
#   unit: mas / yr
#   datatype: float32
#   description: Proper motion error major axis
#   meta: !!omap
#   - {ucd: phys.angSize.smajAxis;pos.errorEllipse;pos.pm}
#   - {utype: 'mango:EpochPosition.errors.properMotion/mango:error.PErrorEllipse.semiMajorAxis[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: pm_err_mina
#   unit: mas / yr
#   datatype: float32
#   description: Proper motion error minor axis
#   meta: !!omap
#   - {ucd: phys.angSize.sminAxis;pos.errorEllipse;pos.pm}
#   - {utype: 'mango:EpochPosition.errors.properMotion/mango:error.PErrorEllipse.semiMinorAxis[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: plx_value
#   unit: mas
#   datatype: float64
#   description: Parallax
#   meta: !!omap
#   - {ucd: pos.parallax.trig}
#   - {utype: 'mango:EpochPosition.parallax[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: plx_error
#   unit: mas
#   datatype: float32
#   description: Parallax error
#   meta: !!omap
#   - {ucd: stat.error;pos.parallax.trig}
# - name: plx_bibcode
#   datatype: string
#   description: Parallax reference
#   meta: !!omap
#   - {ucd: meta.bib.bibcode;pos.parallax.trig}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: rv_value
#   unit: km / s
#   datatype: float64
#   description: Radial Velocity
#   meta: !!omap
#   - {ucd: spect.dopplerVeloc.opt}
#   - {utype: 'mango:EpochPosition.radialVelocity[CS.spaceSys=ICRS CT.epoch=J2000]'}
# - name: rvz_error
#   unit: km / s
#   datatype: float32
#   description: Radial velocity / redshift error
#   meta: !!omap
#   - {ucd: stat.error;spect.dopplerVeloc}
# schema: astropy-2.0
user_specified_id user_specified_ra user_specified_dec user_specified_mjd_obs main_id all_ids ra dec otype sp_type flux_v flux_r flux_i flux_j flux_h flux_k pmra pmdec pm_err_maja pm_err_mina plx_value plx_error plx_bibcode rv_value rvz_error
